# ------------------------------
# Application
# ------------------------------
APP_NAME=AI Logistics Route Optimizer
ENVIRONMENT=development
DEBUG=false

# API Runtime
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:4173

# ------------------------------
# Security / Auth
# ------------------------------
SECRET_KEY=change-me-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------
# Database (local)
# ------------------------------
POSTGRES_DB=ai_logistics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy URL used by backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_logistics

# ------------------------------
# CORS
# ------------------------------
BACKEND_CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:5173

# ------------------------------
# Frontend
# ------------------------------
VITE_API_BASE_URL=http://localhost:8000
